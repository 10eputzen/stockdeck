# Frontend (Vite). Kopieren nach .env und ausfüllen; .env ist in .gitignore.
# Werte: Supabase-Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://<projekt-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<key>
# Öffentliche App-URL (Link in Einladungen); leer = aktuelle Adresse im Browser
VITE_SITE_URL=https://<deine-app>.pages.dev
# Web-Push: Public Key aus npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=<vapid-public-key>

# Nur für npm run deploy (Cloudflare Pages). Können auch in .env.deploy stehen.
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
# PAGES_PROJECT=stockdeck
# Tokens per Umgebung oder hier (nie einchecken), sonst aus dem Secret Manager von STOCKDECK_GCP_PROJECT:
# SUPABASE_ACCESS_TOKEN=sbp_<token>
# CLOUDFLARE_API_TOKEN=<token-mit-pages-edit>
