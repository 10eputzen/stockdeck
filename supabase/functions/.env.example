# Secrets der Edge Functions. Kopieren nach supabase/functions/.env (nicht einchecken) und setzen mit:
#   supabase secrets set --env-file supabase/functions/.env
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY stellt Supabase selbst bereit.

# Öffentliche App-URL ohne / am Ende: CORS (inkl. Subdomains) und Text im MCP-Server
SITE_URL=https://<deine-app>.pages.dev

# Kurse, Suche, Logos: https://finnhub.io/dashboard
FINNHUB_API_KEY=<finnhub-key>

# Web-Push: npx web-push generate-vapid-keys (Public Key auch als VITE_VAPID_PUBLIC_KEY im Frontend)
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:du@example.com

# Gleicher Wert wie das Vault-Secret alerts_cron_secret (schützt den Cron-Aufruf der Function alerts)
ALERTS_CRON_SECRET=<zufälliger-string>
